load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "sofia_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "sofia_e2e_benchmark")

sofia_rust_crate(
    name = "cli",
    binaries_with_build_commit = ["sofia"],
    crate_name = "sofia_cli",
    extra_binaries = [
        "//sofia-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "sofia",
)

sofia_e2e_benchmark(
    name = "sofia-help",
    binaries = [":sofia"],
)
